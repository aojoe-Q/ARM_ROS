<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="dm_mc02_ros2_control" params="name device allow_enable">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>dm_mc02_hardware/DmMc02System</plugin>
        <param name="device">${device}</param>
        <param name="allow_enable">${allow_enable}</param>
        <!-- Set to 1 ONLY after measuring every joint's sign/offset against the URDF. -->
        <param name="mapping_calibrated">0</param>

        <!-- Per-joint config: calibrated sign/offset, firmware static limits and host step limit. -->
        <!-- Offsets must be measured at the real zero; J3 is not 0.1 rad by definition. -->
        <param name="joint1_sign">1.0</param><param name="joint1_offset">0.0</param>
        <param name="joint1_mcu_min">-2.96054893</param><param name="joint1_mcu_max">2.81695309</param><param name="joint1_max_step_rad">0.01</param>
        <param name="joint2_sign">1.0</param><param name="joint2_offset">0.0</param>
        <param name="joint2_mcu_min">-2.05669899</param><param name="joint2_mcu_max">0.0</param><param name="joint2_max_step_rad">0.01</param>
        <param name="joint3_sign">1.0</param><param name="joint3_offset">0.0</param>
        <param name="joint3_mcu_min">-3.00016972</param><param name="joint3_mcu_max">0.0</param><param name="joint3_max_step_rad">0.01</param>
        <param name="joint4_sign">1.0</param><param name="joint4_offset">0.0</param>
        <param name="joint4_mcu_min">0.0</param><param name="joint4_mcu_max">3.00567291</param><param name="joint4_max_step_rad">0.01</param>
        <param name="joint5_sign">1.0</param><param name="joint5_offset">0.0</param>
        <param name="joint5_mcu_min">-0.904316101</param><param name="joint5_mcu_max">1.40938965</param><param name="joint5_max_step_rad">0.01</param>
        <param name="joint6_sign">1.0</param><param name="joint6_offset">0.0</param>
        <param name="joint6_mcu_min">-0.650879326</param><param name="joint6_mcu_max">2.32408657</param><param name="joint6_max_step_rad">0.01</param>

        <!-- Hard limits are firmware bounds, NOT measured open/closed endpoints. -->
        <param name="grip_mcu_min">-12.0</param>
        <param name="grip_mcu_max">0.0</param>
        <param name="grip_calibrated">0</param>
        <param name="grip_q_close_m">-0.000523</param>
        <param name="grip_q_open_m">0.009530</param>
        <param name="grip_mcu_closed">0.0</param>
        <param name="grip_mcu_open">0.0</param> <!-- placeholder: replace both endpoints before calibration -->
        <param name="grip_command_enable">0</param>  <!-- 0 = hold until calibrated -->

        <!-- Timing -->
        <param name="valid_time_ms">100</param>
        <param name="state_timeout_ms">100</param>
      </hardware>

      <joint name="joint1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint4">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint5">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint6">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="joint8">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>



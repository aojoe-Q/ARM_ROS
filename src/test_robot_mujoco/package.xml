<?xml version="1.0"?>
<package format="3">
  <name>test_robot_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo physics backend for test_robot and ros2_control.</description>
  <maintainer email="yaq@todo.todo">yaq</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
